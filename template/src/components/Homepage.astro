---
import background from '../assets/background.svg';
---


<div class="site-container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main class="site-main">
		<h1 class="site-title">HackProof: Learn to Defend the Digital World</h1>
		<nav class="tabs main-nav" style="justify-content:center;margin:18px 0 28px;">
			<a class="tab" href="/content-analysis">
				<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 10-.71.71l.27.28v.79L20 20.49 21.49 19 15.5 14zM10.5 15a4.5 4.5 0 110-9 4.5 4.5 0 010 9z"/></svg>
				Content Analysis
			</a>
			<a class="tab" href="/learning">
				<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 3L2 9l10 6 10-6-10-6zm0 7.5L4.2 9 12 5.5 19.8 9 12 10.5zM2 17l10 6 10-6v2l-10 6L2 19v-2z"/></svg>
				Learning
			</a>
			<a class="tab" href="/quizzes">
				<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11 9h2V7h-2v2zm1-9C5.48 0 1 4.48 1 10s4.48 10 10 10 10-4.48 10-10S16.52 0 12 0zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/></svg>
				Quizzes
			</a>
			<a class="tab" href="/glossary">
				<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H6zm0 2h5v8l-2.5-1.5L6 12V4z"/></svg>
				Glossary
			</a>
		</nav>

		<section class="card" style="text-align:center;">
			<h2 class="section-title">Welcome!</h2>
			<p class="lead">Select a tab above to explore content analysis, quizzes, or learning resources for cybersecurity. You'll find interactive assessments and real-life scenarios to build practical skills.</p>
		</section>

		<!-- Explore Cybersecurity feature cards -->
		<section class="feature-section">
			<h2 class="section-title" style="text-align:center;margin-top:22px">Explore Cybersecurity</h2>
			<div class="feature-grid">
				<a class="feature-card" href="/content-analysis">
					<div class="feature-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 10-.71.71l.27.28v.79L20 20.49 21.49 19 15.5 14zM10.5 15a4.5 4.5 0 110-9 4.5 4.5 0 010 9z"/></svg>
					</div>
					<h3>Content Analysis</h3>
					<p>Analyze suspicious messages, emails, and websites to identify cybersecurity threats.</p>
					<span class="feature-btn">Start Analyzing</span>
				</a>
				<a class="feature-card" href="/learning">
					<div class="feature-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M12 3L2 9l10 6 10-6-10-6zm0 7.5L4.2 9 12 5.5 19.8 9 12 10.5zM2 17l10 6 10-6v2l-10 6L2 19v-2z"/></svg>
					</div>
					<h3>Learning Modules</h3>
					<p>Learn core cybersecurity concepts such as malware, phishing, cryptography, and network security.</p>
					<span class="feature-btn">Start Learning</span>
				</a>
				<a class="feature-card" href="/quizzes">
					<div class="feature-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M11 9h2V7h-2v2zm1-9C5.48 0 1 4.48 1 10s4.48 10 10 10 10-4.48 10-10S16.52 0 12 0zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8c4.41 0 8 3.59 8 8s-3.59 8-8 8z"/></svg>
					</div>
					<h3>Cybersecurity Quizzes</h3>
					<p>Test your cybersecurity knowledge through interactive quizzes and real-world scenarios.</p>
					<span class="feature-btn">Take a Quiz</span>
				</a>
				<a class="feature-card" href="/glossary">
					<div class="feature-icon">
						<svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M6 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H6zm0 2h5v8l-2.5-1.5L6 12V4z"/></svg>
					</div>
					<h3>Glossary</h3>
					<p>Look up plain-English definitions for phishing, malware, encryption, and other common security terms.</p>
					<span class="feature-btn">Browse Terms</span>
				</a>
			</div>
		</section>

		<!-- Why Cybersecurity Matters -->
		<section class="why-section">
			<h2 class="section-title">Why Cybersecurity Matters</h2>
			<p class="lead" style="max-width:800px;margin:10px auto 18px;">Every day, millions of cyberattacks occur across the internet. Learning cybersecurity basics helps individuals recognize threats, protect their personal data, and safely navigate the digital world.</p>
			<div class="stats">
				<div class="stat-item">
					<div class="stat-icon">🔒</div>
					<div class="stat-text">3.4 billion phishing emails are sent every day</div>
				</div>
				<div class="stat-item">
					<div class="stat-icon">⏱️</div>
					<div class="stat-text">A cyberattack occurs approximately every 39 seconds</div>
				</div>
				<div class="stat-item">
					<div class="stat-icon">🛡️</div>
					<div class="stat-text">Over 90% of data breaches begin with human error</div>
				</div>
			</div>
		</section>

		<!-- Try a Cyber Challenge -->
		<section class="challenge-section">
			<h2 class="section-title">Try a Cyber Challenge</h2>
			<div class="challenge-grid">
				<div class="challenge-card">
  					<h3>Is This a Scam?</h3>
  					<p id="challenge-progress">Scenario 1 of 3</p>
			<div id="challenge-message">
  				<p><strong>From:</strong> alerts@securepay-support-verify.com</p>
  				<p><strong>Subject:</strong> Unusual Sign-in Attempt Detected</p>
  				<p class="muted">
    				"We detected a login from an unrecognized device in a different country.
    				If this wasn't you, verify your identity within 24 hours or your account
    				will be permanently suspended. Click here to verify now."
  				</p>
			</div>
			<div id="challenge-choices" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;">
    			<button id="btn-safe" class="btn secondary" type="button">
        			✅ Looks Safe
				</button>
    			<button id="btn-suspicious" class="btn" type="button">
        			⚠️ Looks Suspicious
    			</button>
			</div>

			<div id="challenge-feedback" class="feedback" hidden></div>
			<button id="btn-next" class="btn" type="button" hidden>Next →</button>

			</div>
				<div class="tip-and-journey">
					<div class="tip-box">
						<strong>Cyber Tip of the Day</strong>
						<p>Never reuse the same password across multiple websites. If one account is compromised, attackers often try the same password on other services.</p>
					</div>
					<!-- Roadmap -->
					<div class="roadmap">
						<h3>Your Cybersecurity Journey</h3>
						<div class="roadmap-steps">
							<div class="roadmap-step">
								<div class="step-icon">📘</div>
								<div class="step-title">Learn the Basics</div>
								<div class="step-desc">Understand common online threats and security practices.</div>
							</div>
							<div class="roadmap-step">
								<div class="step-icon">🔎</div>
								<div class="step-title">Analyze Real Threats</div>
								<div class="step-desc">Practice identifying phishing attempts and suspicious activity.</div>
							</div>
							<div class="roadmap-step">
								<div class="step-icon">🏆</div>
								<div class="step-title">Test Your Knowledge</div>
								<div class="step-desc">Complete quizzes to reinforce your cybersecurity skills.</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="site-footer">
			<div class="footer-inner">
				<div>HackProof © 2026<br/>Cybersecurity Education Project</div>
				<div class="footer-links">
					<a href="/resources">Resources</a>
					<a href="/about">About</a>
					<a href="/contact">Contact</a>
						<a href="/glossary">Glossary</a>
				</div>
			</div>
		</footer>
	</main>
</div>
<script>
  const scenarios = [
    {
      from: "alerts@securepay-support-verify.com",
      subject: "Unusual Sign-in Attempt Detected",
      body: "We detected a login from an unrecognized device in a different country. If this wasn't you, verify your identity within 24 hours or your account will be permanently suspended. Click here to verify now.",
      isSuspicious: true,
      explanation: "This message creates urgency and threatens account suspension to pressure you into clicking a suspicious link."
    },
    {
      from: "statements@northfield-creditunion.com",
      subject: "Your December E-Statement Is Ready",
      body: "Hi Jordan, your December account statement is now available. Log in to your account directly to view it. No immediate action is needed.",
      isSuspicious: false,
      explanation: "This message doesn't pressure you to click a link or share personal information. However, you should still verify unexpected messages by visiting the organization's official website directly."
    },
    {
      from: "rewards@teamspirit-appreciation.net",
      subject: "You've Earned a $100 Appreciation Reward!",
      body: "Congratulations! You've been selected for a $100 Employee Appreciation gift card. Claim your reward within 2 hours by entering your employee ID and email address.",
      isSuspicious: true,
      explanation: "This message uses the promise of a reward and a short deadline to pressure you into sharing personal information."
    }
  ];

  let currentIndex = 0;
  let score = 0;

  const messageEl = document.getElementById("challenge-message");
  const progressEl = document.getElementById("challenge-progress");
  const feedbackEl = document.getElementById("challenge-feedback");
  const nextBtn = document.getElementById("btn-next");
  const safeBtn = document.getElementById("btn-safe");
  const suspiciousBtn = document.getElementById("btn-suspicious");
  const choicesEl = document.getElementById("challenge-choices");

function renderScenario() {
    if (!messageEl || !progressEl) return;

    const scenario = scenarios[currentIndex];

    messageEl.innerHTML = `
        <p><strong>From:</strong> ${scenario.from}</p>
        <p><strong>Subject:</strong> ${scenario.subject}</p>
        <p class="muted">${scenario.body}</p>
    `;

    progressEl.textContent = `Scenario ${currentIndex + 1} of ${scenarios.length}`;
	}

function handleAnswer(userGuessSuspicious: boolean) {
    if (!feedbackEl || !nextBtn || !safeBtn || !suspiciousBtn) return;

    const scenario = scenarios[currentIndex];

    // Check whether the user's answer is correct
    const isCorrect = userGuessSuspicious === scenario.isSuspicious;

    // Increase the score for a correct answer
    if (isCorrect) {
        score++;
    }

    // Prepare the feedback message
    const resultText = isCorrect ? "✅ Correct!" : "❌ Not quite.";
    const resultClass = isCorrect ? "correct" : "incorrect";

    // Display feedback and explanation
    feedbackEl.innerHTML = `<span class="${resultClass}">${resultText}</span> ${scenario.explanation}`;

    // Reveal feedback and Next button
    feedbackEl.hidden = false;
    nextBtn.hidden = false;

    // Prevent the user from answering twice
    safeBtn.setAttribute("disabled", "");
    suspiciousBtn.setAttribute("disabled", "");
}

// Move to the next scenario
function goToNext() {
    currentIndex++;

    if (currentIndex < scenarios.length) {
        if (!feedbackEl || !nextBtn || !safeBtn || !suspiciousBtn) return;

        // Hide previous feedback
        feedbackEl.hidden = true;
        nextBtn.hidden = true;

        // Enable answer buttons for the next scenario
        safeBtn.removeAttribute("disabled");
        suspiciousBtn.removeAttribute("disabled");

        // Display the next scenario
        renderScenario();

    } else {
        if (!messageEl || !progressEl || !feedbackEl || !nextBtn || !choicesEl) return;

        // Display final score
        messageEl.innerHTML = `
            <h3>Challenge Complete!</h3>
            <p>You got ${score} out of ${scenarios.length} correct!</p>
            <p class="muted">
                Keep practicing to improve your ability to recognize online scams.
            </p>
            <button id="btn-restart" class="btn secondary" type="button" style="margin-top:8px;">Restart Challenge</button>
        `;

        // Hide elements that are no longer needed
        progressEl.hidden = true;
        feedbackEl.hidden = true;
        nextBtn.hidden = true;
        choicesEl.hidden = true;

        // The restart button only exists in the DOM now that we've just
        // created it above, so it has to be looked up and wired up here
        document.getElementById("btn-restart")?.addEventListener("click", restartChallenge);
    }
}

// Reset the activity back to the first scenario
function restartChallenge() {
    currentIndex = 0;
    score = 0;

    if (!progressEl || !choicesEl || !feedbackEl || !nextBtn || !safeBtn || !suspiciousBtn) return;

    // Show the elements the final score screen had hidden
    progressEl.hidden = false;
    choicesEl.hidden = false;
    feedbackEl.hidden = true;
    nextBtn.hidden = true;

    // Re-enable the answer buttons in case the last scenario left them disabled
    safeBtn.removeAttribute("disabled");
    suspiciousBtn.removeAttribute("disabled");

    renderScenario();
}

	// Display the first scenario when the page loads
	renderScenario();

	// Connect the answer buttons
	safeBtn?.addEventListener("click", () => handleAnswer(false));
	suspiciousBtn?.addEventListener("click", () => handleAnswer(true));

	// Connect the Next button
	nextBtn?.addEventListener("click", goToNext);
	</script>